<Window x:Class="WpfSoundMonitor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfSoundMonitor.Windows"
        mc:Ignorable="d"
        Title="WPF Sound Monitor" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- First column (left) -->
        <StackPanel Grid.Column="0">

            <TextBlock Text="Capture Devices :" 
                       FontWeight="Bold" 
                       Margin="5,5,5,5"/>

            <Button Name="Btn_RefreshCaptureDevices" 
                    Content="Refresh capture devices"
                    Click="Btn_RefreshCaptureDevices_Click" 
                    Margin="5,0,5,5"/>

            <ListBox Name="Lstbox_CaptureDevices" 
                     Height="100" 
                     Margin="5,0,5,5" 
                     SelectionChanged="Lstbox_CaptureDevices_SelectionChanged" 
                     d:ItemsSource="{d:SampleData ItemCount=5}"/>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Sample buffer duration [ms] : " 
                           Width="175" 
                           Margin="5,0,0,5"/>

                <TextBox Name="TxtBox_SampleDurationMs" 
                         Width="165" 
                         Margin="0,0,5,5"
                         PreviewTextInput="TxtBox_Validation_Number_Integer" 
                         Text="100"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">

                <Button Name="Btn_StartCapture" 
                        Content="Start capture"  
                        Width="165" 
                        Margin="5,0,5,5"
                        HorizontalAlignment="Left" 
                        Click="Btn_StartCapture_Click" 
                        IsEnabled="False" />

                <Button Name="Btn_StopCapture" 
                        Content="Stop capture"  
                        Width="165" 
                        Margin="5,0,5,5"
                        HorizontalAlignment="Right" 
                        Click="Btn_StopCapture_Click" 
                        IsEnabled="False" />

            </StackPanel>

            <TextBlock Text="Too much noise analyzer settings :"
                       FontWeight="Bold" 
                       Margin="5,5,5,5"/>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Start Threshold : " 
                           Width="175" 
                           Margin="5,0,0,5"/>

                <TextBox Name="TxtBox_StartThreshold" 
                         Width="165" 
                         Margin="0,0,5,5"
                         PreviewTextInput="TxtBox_Validation_Number_Decimal" 
                         Text="0.5"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Analyze duration [ms] : " 
                           Width="175" 
                           Margin="5,0,0,5"/>

                <TextBox Name="TxtBox_AnalyzeDuration" 
                         Width="165" 
                         Margin="0,0,5,5"
                         PreviewTextInput="TxtBox_Validation_Number_Integer" 
                         Text="5000"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Max average value : " 
                           Width="175" 
                           Margin="5,0,0,5"/>

                <TextBox Name="TxtBox_MaxAverageValue" 
                         Width="165" 
                         Margin="0,0,5,5"
                         PreviewTextInput="TxtBox_Validation_Number_Decimal" 
                         Text="1.000"/>

            </StackPanel>

        </StackPanel>

        <!-- Second column (right) -->
        <StackPanel Grid.Column="1">

            <TextBlock Text="Wave render :" 
                       FontWeight="Bold"  
                       Margin="5,5,5,5"/>

            <!-- Container for SFML -->
            <WindowsFormsHost x:Name="SfmlHost" 
                              Grid.Column="1"  
                              Height="200" 
                              VerticalAlignment="Top"  
                              Margin="5,0,5,5"/>

            <ScrollBar 
                Name="ScrollBarSfmlRenderArea" 
                Width="440" 
                Margin="5,0,5,5" 
                Orientation="Horizontal" 
                Minimum="0" 
                Maximum="100" 
                ValueChanged="ScrollBarSfmlRenderArea_ValueChanged"/>

            <TextBlock Text="Datastream values : "
                       Margin="5,0,5,5"
                       FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Samples count : "
                           Margin ="5,0,5,5"
                           Width="150"/>

                <TextBox Name="TxtBox_SamplesCount" 
                         Width="165" 
                         Margin="0,0,5,5"
                         IsEnabled="False"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Current value : "
                           Margin ="5,0,5,5"
                           Width="150"/>

                <TextBox Name="TxtBox_CurrentSampleValue" 
                         Width="165" 
                         Margin="0,0,5,5"
                         IsEnabled="False"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Samples max value : "
                           Margin ="5,0,5,5"
                           Width="150"/>

                <TextBox Name="TxtBox_SamplesMaxValue" 
                         Width="165" 
                         Margin="0,0,5,5"
                         IsEnabled="False"/>    

            </StackPanel>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Samples average value : "
                           Margin ="5,0,5,5"
                           Width="150"/>

                <TextBox Name="TxtBox_SamplesAvgValue" 
                         Width="165" 
                         Margin="0,0,5,5"
                         IsEnabled="False"/>

            </StackPanel>

            <TextBlock Text="Selected sample details :"
                       Margin="5,0,5,5"
                       FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Last average value : "
                           Margin ="5,0,5,5"
                           Width="150"/>

                <TextBox Name="TxtBox_SelectedSampleAvgValue" 
                         Width="165" 
                         Margin="0,0,5,5"
                         IsEnabled="False"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Threshold reached : "
                           Margin ="5,0,5,5"
                           Width="150"/>

                <TextBox Name="TxtBox_SelectedSampleThresholdReached" 
                         Width="165" 
                         Margin="0,0,5,5"
                         IsEnabled="False"/>

            </StackPanel>

        </StackPanel>

    </Grid>
</Window>